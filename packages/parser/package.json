{
  "name": "@sammons/code-outline-parser",
  "version": "2.1.0",
  "type": "module",
  "description": "Tree-sitter based parser for JavaScript/TypeScript code analysis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --test \"src/*.test.ts\""
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "typescript",
    "javascript",
    "ast"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
