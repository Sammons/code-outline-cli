{
  "name": "code-outline-monorepo",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Monorepo for code outline tools using tree-sitter",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean",
    "test": "node --test \"packages/*/src/*.test.ts\" \"src/test-scenarios/*/*.test.ts\"",
    "test:run": "node --test \"packages/*/src/*.test.ts\" \"src/test-scenarios/*/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=70 --test-coverage-functions=70 --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout \"packages/*/src/*.test.ts\" \"src/test-scenarios/*/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "type-check": "tsc --noEmit",
    "website:dev": "pnpm --filter @sammons/website dev",
    "website:build": "pnpm --filter @sammons/website build",
    "website:preview": "pnpm --filter @sammons/website preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "badges": "node scripts/badge-generator.js",
    "docs:check": "node scripts/check-docs-current.ts --exit-code",
    "docs:update": "node scripts/generate-docs.ts",
    "docs:validate": "node scripts/validate-generated-docs.ts"
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "typescript",
    "javascript",
    "cli",
    "ast",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.tail4ea214.ts.net/sammons/code-outline-cli.git"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.2",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.15.1"
}
