{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "composite": true,

    // Source files import siblings with a .ts extension so Node 26 can run them
    // directly under native type stripping (tests, scripts). On emit, tsc
    // rewrites those specifiers to .js so the published dist/ resolves.
    "rewriteRelativeImportExtensions": true
  },
  "exclude": ["node_modules", "dist"]
}
